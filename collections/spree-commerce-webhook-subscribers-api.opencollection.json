{
  "opencollection": "1.0.0",
  "info": {
    "name": "Admin Account / Address Webhook Subscribers API",
    "version": "v3"
  },
  "items": [
    {
      "info": {
        "name": "Webhook Subscribers",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Return a list of Webhook Subscribers",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://{defaultHost}/api/v2/platform/webhooks/subscribers",
            "params": [
              {
                "name": "page",
                "value": "1",
                "type": "query"
              },
              {
                "name": "per_page",
                "value": "50",
                "type": "query"
              },
              {
                "name": "filter[active_eq]",
                "value": "true",
                "type": "query"
              },
              {
                "name": "filter[url_cont]",
                "value": "mysite",
                "type": "query"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns a list of Webhook Subscribers"
        },
        {
          "info": {
            "name": "Create a Webhook Subscriber",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://{defaultHost}/api/v2/platform/webhooks/subscribers",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Creates a Webhook Subscriber"
        },
        {
          "info": {
            "name": "Return a Webhook Subscriber",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://{defaultHost}/api/v2/platform/webhooks/subscribers/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns a Webhook Subscriber"
        },
        {
          "info": {
            "name": "Update a Webhook Subscriber",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "http://{defaultHost}/api/v2/platform/webhooks/subscribers/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Updates a Webhook Subscriber"
        },
        {
          "info": {
            "name": "Delete a Webhook Subscriber",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "http://{defaultHost}/api/v2/platform/webhooks/subscribers/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Deletes a Webhook Subscriber"
        }
      ]
    }
  ],
  "bundled": true
}