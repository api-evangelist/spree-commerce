{
  "opencollection": "1.0.0",
  "info": {
    "name": "Admin Account / Address Line Items API",
    "version": "v3"
  },
  "items": [
    {
      "info": {
        "name": "Line Items",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Return a list of Line Items",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://{defaultHost}/api/v2/platform/line_items",
            "params": [
              {
                "name": "page",
                "value": "1",
                "type": "query"
              },
              {
                "name": "per_page",
                "value": "50",
                "type": "query"
              },
              {
                "name": "include",
                "value": "order,tax_category,variant.product,digital_links",
                "type": "query",
                "description": "Select which associated resources you would like to fetch, see: <a href=\"https://jsonapi.org/format/#fetching-includes\">https://jsonapi.org/format/#fetching-includes</a>"
              },
              {
                "name": "filter[order_id_eq]",
                "value": "123",
                "type": "query"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns a list of Line Items"
        },
        {
          "info": {
