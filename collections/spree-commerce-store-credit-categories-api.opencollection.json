{
  "opencollection": "1.0.0",
  "info": {
    "name": "Admin Account / Address Store Credit Categories API",
    "version": "v3"
  },
  "items": [
    {
      "info": {
        "name": "Store Credit Categories",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Return a list of Store Credit Categories",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://{defaultHost}/api/v2/platform/store_credit_categories",
            "params": [
              {
                "name": "page",
                "value": "1",
                "type": "query"
              },
              {
                "name": "per_page",
                "value": "50",
                "type": "query"
              },
              {
                "name": "filter[name_eq]",
                "value": "refunded",
                "type": "query"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns a list of Store Credit Categories"
        },
        {
          "info": {
