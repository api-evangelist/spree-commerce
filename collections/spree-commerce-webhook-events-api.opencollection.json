{
  "opencollection": "1.0.0",
  "info": {
    "name": "Admin Account / Address Webhook Events API",
    "version": "v3"
  },
  "items": [
    {
      "info": {
        "name": "Webhook Events",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Return a list of Webhook Events",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://{defaultHost}/api/v2/platform/webhooks/events",
            "params": [
              {
                "name": "page",
                "value": "1",
                "type": "query"
              },
              {
                "name": "per_page",
                "value": "50",
                "type": "query"
              },
              {
                "name": "include",
                "value": "subscriber",
                "type": "query",
                "description": "Select which associated resources you would like to fetch, see: <a href=\"https://jsonapi.org/format/#fetching-includes\">https://jsonapi.org/format/#fetching-includes</a>"
              },
              {
                "name": "filter[name_eq]",
                "value": "order.canceled",
                "type": "query"
              },
              {
                "name": "filter[request_errors_cont]",
                "value": "google",
                "type": "query"
              },
              {
                "name": "filter[response_code_eq]",
                "value": "200",
                "type": "query"
              },
              {
                "name": "filter[success_eq]",
                "value": "true",
                "type": "query"
              },
              {
                "name": "filter[url_cont]",
                "value": "mysite",
                "type": "query"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns a list of Webhook Events"
        }
      ]
    }
  ],
  "bundled": true
}