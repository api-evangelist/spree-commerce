          "name": "Add Store Credit",
          "request": {
            "name": "Add Store Credit",
            "description": {
              "content": "The Add Store Credit endpoint takes the users existing store credit from their account and adds a set amount of this store credit to the current cart.\n\nIn essence, by adding the user's store credit to a cart, the user's store credit is being spent.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v2",
                "storefront",
                "checkout",
                "add_store_credit"
