          },
          "http": {
            "method": "GET",
            "url": "http://{defaultHost}/api/v2/platform/adjustments",
            "params": [
              {
                "name": "page",
                "value": "1",
                "type": "query"
              },
              {
                "name": "per_page",
                "value": "50",
                "type": "query"
              },
              {
                "name": "include",
